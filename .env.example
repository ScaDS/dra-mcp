# Form to fill: saxony (Dienstreiseantrag Anlage 1, VwV-SächsRKG) or tud (TU Dresden RK-02)
DRA_FORM=saxony

# Applicant details, used whenever a call leaves them empty
SERVICE_UNIT=
APPLICANT_NAME=
DEPARTMENT=
OFFICE_PHONE=
HOME_ADDRESS=
ADDITIONAL_HOME_ADDRESS=
TEMPORARY_STAY_ADDRESS=
IBAN=
BIC=
BANK_NAME=
# Personal-Nr. (TU Dresden form only)
PERSONNEL_NUMBER=

# Where trips usually start and end: home-a, home-b, office or temporary-address
TRAVEL_START_FROM=
TRAVEL_END_AT=

# City the travel-time estimates start from (default: Leipzig)
HOME_CITY=
# Folder for filled PDFs (default: output/ in this repository)
OUTPUT_DIR=
